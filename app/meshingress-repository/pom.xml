<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.mrk.meshingress</groupId>
        <artifactId>meshingress</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>meshingress-repository</artifactId>
    <name>meshingress-repository</name>
    <description>Private artifact repository for reviewed Meshingress runtime assets</description>

    <dependencies>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-artifact-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-artifact-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-artifact-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-artifact-publication</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-artifact-scope-scanner</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>meshingress-repository</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <skip>false</skip>
                    <mainClass>dev.mrk.meshingress.repository.MeshingressRepositoryApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
