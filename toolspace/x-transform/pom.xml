<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.mrk.meshingress</groupId>
        <artifactId>meshingress</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>dev.mrk.toolspace.transform</groupId>
    <artifactId>x-transform</artifactId>
    <name>x-transform</name>
    <description>Backend-only Transform conversion tool for Meshingress.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.mrk.meshingress</groupId>
                <artifactId>meshingress-tool-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-tool-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-tool-framework</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>transform-backend/node_modules/**</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
