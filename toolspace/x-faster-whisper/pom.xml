<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.mrk.meshingress</groupId>
        <artifactId>meshingress</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>org.toolspace.fasterwhisper</groupId>
    <artifactId>x-faster-whisper</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-tool-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-tool-annotations</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-tool-api-manifest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mrk.meshingress</groupId>
            <artifactId>meshingress-tool-framework</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <!-- Local development source only; published tools provision their trusted revision. -->
                    <exclude>vendor/**</exclude>
                    <!-- Defensive: a local environment must never enter an artifact. -->
                    <exclude>**/.venv/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>generate-static-tool-manifest</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dev.mrk.meshingress.toolmetadata.McpToolManifestExecutor</mainClass>
                            <arguments>
                                <argument>org.toolspace.fasterwhisper.FasterWhisperManifest</argument>
                                <argument>${project.build.outputDirectory}/META-INF/meshingress/tool-manifest.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- Also guard incremental builds whose target/classes contains old resources. -->
                    <excludes>
                        <exclude>vendor/**</exclude>
                        <exclude>**/.venv/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
