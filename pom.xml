<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>dev.mrk.meshingress</groupId>
    <artifactId>meshingress</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>meshingress</name>
    <description>Meshingress MCP server and attachable tool modules</description>

    <modules>
        <module>app/meshingress-server</module>

        <module>lib/meshingress-route-annotations</module>
        <module>lib/meshingress-route-api</module>
        <module>lib/meshingress-route-framework</module>
        <module>lib/meshingress-tool-api</module>
        <module>lib/meshingress-tool-annotations</module>
        <module>lib/meshingress-tool-framework</module>

        <module>toolspace/helloworld</module>
        <module>toolspace/instagram-api</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>
    <dependencies>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
<!--                    <mainClass>dev.mrk.meshingress.MeshingressApplication</mainClass>-->
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
